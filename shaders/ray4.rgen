#version 460 core
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_scalar_block_layout : require
// Allocation/LRU phase. All path passes have already submitted their
// current-frame geometry requests before the group-2 barrier reaches here.
#include "/lib/buffers/radiance_cache.glsl"
#include "/lib/rt/camera_state.glsl"

void main() {
    if (any(notEqual(gl_LaunchIDEXT, uvec3(0u)))) return;
    vec3 currentCameraPosition = cam.viewInverse[3].xyz;
    processRadianceCacheAllocationRequests(
        currentCameraPosition, cam.frameId);
    RtCameraMatrices currentCamera = buildRtCameraMatrices(
        vec2(resolution_global));
    publishRtCameraState(currentCamera);
}
