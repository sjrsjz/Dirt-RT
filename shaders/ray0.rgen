#version 460 core
#extension GL_EXT_ray_query : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_ARB_shader_texture_lod : enable
#define IN_VULKANITE

#define PREV_DIFFUSE_BUFFER

#include "/lib/rt/payload.glsl"
#include "/lib/constants.glsl"
#include "/lib/settings.glsl"
#include "/lib/sky_color.glsl"
#include "/lib/colors.glsl"
#include "/lib/quaternions.glsl"
#include "/lib/buffers/denoise.glsl"
#include "/lib/buffers/frame_data.glsl"

layout(std140, binding = 0) uniform CameraInfo {
    vec3 corners[4];
    mat4 viewInverse;
    vec4 sunPosition;
    vec4 moonPosition;
    uint frameId;
    uint flags;
    uint world_type;
} cam;

layout(binding = 1) uniform accelerationStructureEXT acc;
layout(binding = 3) uniform sampler2D blockTex;
layout(binding = 6) writeonly uniform image2D RayTraceData;
layout(location = 6) rayPayloadEXT Payload payload;

vec4 Trace(uvec2 coord, vec3 ro, vec3 rd, vec3 half_rd, vec3 lightDir);

#include "/lib/common.glsl"

bool isDarkened = false;
vec3 SunLight = vec3(0);
vec3 MoonLight = vec3(0);

vec3 o_seed;
float p0_g;
bool useLastFrameSample = false;

void main() {
    vec2 px = vec2(gl_LaunchIDEXT.xy);
    if (px.x >= gl_LaunchSizeEXT.x || px.y >= gl_LaunchSizeEXT.y) return;
    vec2 p = px / vec2(gl_LaunchSizeEXT.xy);
    vec2 half_p = p * 2;

    world_type_global = int(cam.world_type);

    vec3 origin = cam.viewInverse[3].xyz;
    vec3 target = mix(mix(cam.corners[0], cam.corners[2], p.y), mix(cam.corners[1], cam.corners[3], p.y), p.x);
    vec3 direction = normalize((cam.viewInverse * vec4(target.xyz, 0.0)).xyz);

    vec3 half_target = mix(mix(cam.corners[0], cam.corners[2], half_p.y), mix(cam.corners[1], cam.corners[3], half_p.y), half_p.x);
    vec3 half_direction = normalize((cam.viewInverse * vec4(target.xyz, 0.0)).xyz);

    iFrame = cam.frameId;
    isDarkened = world_type_global != World_OVERWORLD && world_type_global != World_THE_END && world_type_global != World_THE_NETHER;
    SunLight = isDarkened ? vec3(0) : vec3(SunDivMoon * (1 - 0.975 * rainStrength_global));
    SunLight = mix(SunLight, vec3(0.125 * SunDivMoon), float(world_type_global == World_THE_END));
    MoonLight = isDarkened ? vec3(0) : vec3(0.2);

    vec4 celestialQuat = quatAxisAngle(vec3(1, 0, 0), radians(sunPathRotation));
    vec3 sunDir = quatRotate(normalize(mat3(cam.viewInverse) * cam.sunPosition.xyz), celestialQuat);
    vec3 moonDir = quatRotate(normalize(mat3(cam.viewInverse) * cam.moonPosition.xyz), celestialQuat);

    wseed = floatBitsToUint(rand(origin + direction * iFrame));

    vec3 seed0 = vec3(randcore4(), randcore4(), randcore4());
    wseed3.x = floatBitsToUint(seed0.x);
    wseed3.y = floatBitsToUint(seed0.y);
    wseed3.z = floatBitsToUint(seed0.z);

    setSkyVars();
    vec4 color = Trace(uvec2(gl_LaunchIDEXT.xy), origin, direction, half_direction, -sunDir);

    imageStore(RayTraceData, ivec2(gl_LaunchIDEXT), max(color, vec4(0)));
    if (gl_LaunchIDEXT.xy == vec2(0)) {
        SunLight_global = SunLight;
        MoonLight_global = MoonLight;
        lightDir_global = sunDir;
        frame_id = int(cam.frameId);
        camPos = origin;
        camY_global = (cam.viewInverse * vec4(normalize(cam.corners[0] - cam.corners[2]), 0)).xyz;
        camX_global = (cam.viewInverse * vec4(normalize(cam.corners[0] - cam.corners[1]), 0)).xyz;
    }
}

Payload tmp_Payload;

float raycast(in vec3 ro, in vec3 rd, out vec3 ro_o, out vec3 rd_o, bool inverse_0, i16vec2 ignore_block_id) {
    payload.wetStrength_global = wetStrength_global;
    payload.wetness_global = wetness_global;
    payload.ignore_block_id = ignore_block_id;
    float tMin = 0;
    float tMax = 2048.0;
    uint rayFlags = inverse_0 ? gl_RayFlagsCullBackFacingTrianglesEXT : 0u;
    payload.inside_block = !inverse_0;
    payload.shadowTransmission = vec3(1);
    payload.prev_distance = 0;
    traceRayEXT(acc, rayFlags, 0xFF, 0, 0, 0, ro, tMin, rd, tMax, 6);
    Payload hitPayload = payload;
    float t = hitPayload.hitData.w;
    ro_o = hitPayload.hitData.xyz;
    rd_o = rd;
    tmp_Payload = hitPayload;
    return t;
}

float raycast(in vec3 ro, in vec3 rd, out vec3 ro_o, out vec3 rd_o, bool inverse_0) {
    return raycast(ro, rd, ro_o, rd_o, inverse_0, i16vec2(0));
}

material newMaterial(vec3 Cs, vec3 Cd, vec2 S, vec4 R, vec3 light) {
    material a;
    a.Cs = Cs;
    a.Cd = Cd;
    a.S = S;
    a.R = R;
    a.light = light;
    return a;
}

material Material_(vec3 pos, vec3 nor) {
    vec3 albedo = tmp_Payload.material.albedo * (1 - tmp_Payload.material.ambientOcclusion);
    bool water = tmp_Payload.material.block_id.x == 1000;
    float trans = float(!water && 0.9 < tmp_Payload.material.translucent && tmp_Payload.material.block_id.x != 1001);
    trans = tmp_Payload.material.block_id.x == 1002 ? 0.25 : trans;
    float roughness = water ? 0 : tmp_Payload.material.roughness;
    roughness = tmp_Payload.material.block_id.x == 1002 ? 0 : roughness;
    albedo = water ? vec3(1) : albedo;
    tmp_Payload.material.emission = tmp_Payload.material.block_id.x == 1002 ? albedo * (1 - trans) : tmp_Payload.material.emission;
    tmp_Payload.material.emission *= 25;
    return newMaterial(clamp(tmp_Payload.material.F0, 0, 1), albedo, vec2((1 - tmp_Payload.material.metallic) * trans, 1 - trans), vec4(roughness > 0.01 ? max(roughness, 0.0125) : 0, trans, water, tmp_Payload.material.subsurface_scattering), tmp_Payload.material.emission);
}

vec3 reproject(vec3 worldPos) {
    vec3 prevPlayerPos = worldPos - previousCameraPosition_global;
    vec3 prevViewPos = (gbufferPreviousModelView_global * vec4(prevPlayerPos, 1.0)).xyz;
    vec4 prevClipPos = gbufferPreviousProjection_global * vec4(prevViewPos, 1.0);
    return prevClipPos.xyz / prevClipPos.w * 0.5 + 0.5;
}

vec4 sampleGodRay(vec3 b_Sun, vec3 b_Moon, vec3 ro, vec3 rd, float far, vec3 lightDir, bool hitFace, bool inside) {
    vec3 X, Y, Z;
    XYZ(lightDir, X, Y, Z);
    float r1 = getRnd();
    float alpha = getRnd() * 2 * PI;
    float cosbeta = (1 - r1 * (1 - cosD_S));
    vec3 sampleDir = cosbeta * Y + sqrt(1 - cosbeta * cosbeta) * (cos(alpha) * X + sin(alpha) * Z);

    if (isDarkened || sampleDir.y > 0) return vec4(0, 0, 0, 1e10);
    float rnd = getRnd();
    float h = b_P.x - ro.y;
    vec3 q = vec3(0.00000025);
    vec3 log_rnd = 2 * log(rnd) / q;
    float sampleX = luma(abs(log_rnd / (h + sqrt(max(vec3(0), h * h + log_rnd * rd.y)))));
    vec3 c = vec3(0);
    float s = min(far - 0.01, sampleX);
    vec3 samplePos = ro + s * rd;
    float t = 1;
    if (sampleX > far) {
        c = 0 * float(!hitFace) * getSkyColor(b_Sun, b_Moon, samplePos, rd, -lightDir);
    } else {
        vec3 rd1, ro1;
        t = raycast(samplePos, -sampleDir, ro1, rd1, inside, i16vec2(1001, 0));
        float dot_rd_lightDir = dot(rd, lightDir);
        vec3 b_g0_2 = b_g0 * b_g0;
        vec3 tmp_0 = 1. + b_g0_2 + 2. * b_g0 * dot_rd_lightDir;
        tmp_0 *= tmp_0 * tmp_0;
        vec3 g = 3. / (8. * PI) * (1. + dot_rd_lightDir * dot_rd_lightDir) * (1. - b_g0_2) / (2. + b_g0_2) * inversesqrt(tmp_0);
        c = float(t < -0.5) * g * SampleSky(-sampleDir);
    }
    c *= 0 * tmp_Payload.shadowTransmission * max(0.5 * sqrt(1 - cosD_S * cosD_S) * 0.25 * (1 - 0.5 * clamp(-lightDir.y * 2, 0, 1)), rainStrength_global * 0.125) * exp(-b_Q * h * sampleX + 0.5 * b_Q * sampleX * sampleX * sampleDir.y);
    return vec4(clamp(c, 0, 10), t < -0.5 ? s : -1);
}

// -----------------------------------------------------------------------------------
// 极度安全的次表面散射直接光采样（NEE）
// -----------------------------------------------------------------------------------
vec3 sampleSunlight(vec3 ro, vec3 normal, vec3 Cs, vec3 Cd, vec3 rd_i, vec2 S, vec4 R, vec3 lightDir, bool night, int type, vec3 macroNormal, bool inside) {
    ro += (dot(lightDir, macroNormal) > 0.15 ? lightDir : macroNormal) * 0.001;

    vec3 X, Y, Z;
    XYZ(lightDir, X, Y, Z);
    float r1 = getRnd();
    float alpha = getRnd() * 2 * PI;
    float cosbeta = 1.0 - r1 * (1.0 - cosD_S);
    vec3 sampleDir = cosbeta * Y + sqrt(1.0 - cosbeta * cosbeta) * (cos(alpha) * X + sin(alpha) * Z);

    vec3 ro_o, rd_o;
    float t = raycast(ro, -sampleDir, ro_o, rd_o, !inside, i16vec2(1001, 0));
    if (t > -0.5) return vec3(0.0);

    vec3 sunlight = SampleSky(-sampleDir).xyz * tmp_Payload.shadowTransmission * (1.0 - cosD_S) * PI;

    float IoN = abs(dot(rd_i, normal));
    float OoN = dot(sampleDir, normal);

    vec3 sampleColor = vec3(0.0);

    if (type == Diffussion) {
        sampleColor = Cd;
    } else if (type == Reflection) {
        // Specular 直接光采用原版安全公式
        float IoH_sun = abs(dot(normalize(sampleDir + rd_i), rd_i)) + 1e-6;
        vec4 rC_sun = rColor(Cs, IoH_sun);
        float weightA = GGXpdf(clamp(dot(normalize(sampleDir + rd_i), Y), 0.0, 1.0), 0.0, max(R.x, 1e-6)) * GGX_G2(IoN, abs(OoN), max(R.x, 1e-6));
        sampleColor = weightA * Cs * rC_sun.xyz * S.x / IoH_sun;
    }

    return max(vec3(0.0), sampleColor * sunlight);
}

vec3 GetSpecularDominantDirection(vec3 N, vec3 V, float R) {
    float f = (1.0 - R) * (sqrt(1.0 - R) + R);
    vec3 R0 = reflect(V, N);
    return normalize(mix(N, R0, f));
}

float evaluatePHat(GI_Sample s, vec3 centerPos, vec3 centerNormal, vec3 Cd) {
    float lum = dot(s.radiance, vec3(0.2126, 0.7152, 0.0722));
    float albedo_lum = dot(Cd, vec3(0.2126, 0.7152, 0.0722));
    if (lum < 1e-5) return 0.0;

    float G;
    if (s.is_sky > 0.5) {
        // 【立体角测度】天空：方向恒定为 wi，距离无穷远，不计算 cos_s 也不除以 dist2
        float cos_v = clamp(dot(centerNormal, s.wi), 0.0, 1.0);
        G = cos_v;
    } else {
        // 【面积测度】局部方块：严格的表面间换算
        vec3 L_to_sample = s.pos - centerPos;
        float dist2 = max(dot(L_to_sample, L_to_sample), 0.001); // 避免极其贴近时除以0
        vec3 L_dir = L_to_sample / sqrt(dist2);

        float cos_v = clamp(dot(centerNormal, L_dir), 0.0, 1.0);
        float cos_s = clamp(dot(s.normal, -L_dir), 0.0, 1.0);
        G = (cos_v * cos_s) / dist2;
    }

    return albedo_lum * lum * G;
}

// --- 安全的可见性验证 (双向法线偏移，彻底解决贴地自交) ---
bool traceShadowSafe(vec3 p1, vec3 n1, vec3 p2, vec3 n2) {
    vec3 ro = p1 + n1 * 0.05;
    vec3 target = p2 + n2 * 0.05;
    vec3 dir = target - ro;
    float dist = length(dir);
    if (dist < 0.1) return true;
    vec3 rd = dir / dist;
    vec3 ro_o, rd_o;
    float t = raycast(ro, rd, ro_o, rd_o, false);
    return (t < -0.5 || t > dist - 0.15);
}

// -----------------------------------------------------------------------------------
// 核心：前向路径追踪 (Forward Path Tracing)
// -----------------------------------------------------------------------------------
vec4 Trace(uvec2 coord, vec3 ro, vec3 rd, vec3 half_rd, vec3 lightDir) {
    uint isEyeInWater = cam.flags & 3u;
    uint idx = getIdx(coord);

    bool original_inverse_0 = isEyeInWater != 0; // 锁死原始介质状态，用于 God Ray 采样
    bool inverse_0 = original_inverse_0;

    vec3 ro_i = ro;
    vec3 rd_i = rd;

    // PT 核心状态
    vec3 throughput = vec3(1.0);
    vec3 L_indirect = vec3(0.0);
    vec3 L_direct_0 = vec3(0.0); // 专用于收集第一跳的直接阳光
    vec3 current_absorption = vec3(1.0);

    vec4 fogColor = (isEyeInWater == 2u) ? vec4(0, 0.05, 0.075, 0.1) * 5.0 : vec4(0, 0.325, 0.295, 0.3);
    vec3 global_emission = (isEyeInWater == 2u) ? vec3(1, 0.25, 0.05) * 10.0 : vec3(0);

    // 第一跳 (G-Buffer) 记忆变量
    bool hit_sky_first = false;
    vec3 first_p, first_n, first_macro_n, first_albedo, first_albedo2, first_rd_o;
    float first_t = -1.0, first_roughness = 1.0;
    int first_type = -1;
    vec3 first_rd_i = rd;
    float first_n_i, first_n_o;
    vec3 first_micro_n;
    vec2 mixWeight = vec2(0);
    bool hitSmoothSurface = false;
    vec3 first_absorption = vec3(1.0);
    vec3 first_emission_val = vec3(0.0);
    vec3 first_light_surf = vec3(0.0);
    int depth = 0;
    for (; depth < MaxRay; depth++) {
        vec3 ro_o, rd_o;
        vec4 fogA = float(inverse_0) * fogColor;
        vec3 emissionA = float(inverse_0) * global_emission;

        float t = raycast(ro_i, rd_i, ro_o, rd_o, !inverse_0);

        // --- 1. 未命中 (天空/背景) ---
        if (t < -0.5) {
            vec3 sky = SampleSky(rd_i).xyz;
            if (depth == 0) {
                hit_sky_first = true;
                first_t = -1.0;
                first_absorption = original_inverse_0 ? vec3(0) : vec3(1);
            }
            L_indirect += throughput * sky * current_absorption;
            break;
        }

        // --- 2. 几何与材质信息提取 ---
        vec3 normal = faceforward(tmp_Payload.material.normal, tmp_Payload.material.normal, rd_i);
        vec3 macroNormal = faceforward(tmp_Payload.geometryNormal, tmp_Payload.geometryNormal, rd_i);
        material surface = Material_(ro_o, normal);

        // 法线微扰
        if (surface.R.z > 0.5) {
            vec3 offset = fbm3D(ro_o * 0.125 + time_global * 0.125, 5).yzw * 0.25;
            vec3 dH = normalize(vec3(offset.x, 1, offset.z));
            dH = faceforward(dH, dH, normal);
            normal = normalize(mix(normal, dH, max(0.125 * abs(normal.y), 0)));
        }

        vec3 microNormal = GGXNormal(normal, surface.R.x, ro_o);
        float n_i = inverse_0 ? Refractive_Index : 1.0;
        float n_o = inverse_0 ? 1.0 : Refractive_Index;
        float rs = n_i / n_o;

        // --- 3. 介质吸收与发光 ---
        vec3 segment_absorption = exp(-(inverse_0 ? t * fogA.yzw : max(b_Q * (b_P.x - ro_i.y) * t - 0.5 * b_Q * t * t * rd_i.y, 0.0)));
        current_absorption *= segment_absorption;

        vec3 segment_emission = (1.0 - segment_absorption) / (fogA.yzw + 1e-5) * emissionA;

        // =======================================================================
        // ★ 物理无偏修正：在第 1 步漫反射反弹时忽略自发光（因已被 ReSTIR 解析计算）
        // 在第 2 步及后续弹跳（depth >= 2）时，正常保留自发光，确保多跳能量不流失
        // =======================================================================
        vec3 local_emission = (depth > 0) ? (surface.light + segment_emission) : segment_emission;
        L_indirect += throughput * local_emission;

        // --- 4. 物理 BSDF 采样与路径概率分配 ---
        float F = clamp(fresnel(-rd_i, microNormal, rs), 0.0, 1.0);
        vec4 rC = rColor(surface.Cs, dot(rd_i, microNormal));

        float P_spec = rC.w * surface.S.x;
        float P_refr = (1.0 - P_spec) * surface.S.y;
        float P_diff = 1.0 - P_spec - P_refr;

        float rnd_lobe = getRnd();
        int current_type = -1;
        vec3 next_rd;
        vec3 bsdf_weight = vec3(0.0);

        if (rnd_lobe < P_spec) {
            // [反射 Lobe]
            current_type = Reflection;
            next_rd = reflect(rd_i, microNormal);
            if (dot(next_rd, normal) > 0.0) {
                float IoN = abs(dot(rd_i, normal));
                float OoN = dot(next_rd, normal);
                bsdf_weight = rC.rgb * GGX_G2(IoN, OoN, surface.R.x) * surface.S.x / (max(P_spec, 0.125) + 1e-5);
            }
        } else if (rnd_lobe < P_spec + P_refr) {
            // [折射 Lobe]
            current_type = Refraction;
            bool total_internal = (getRnd() < 1.0 - F);
            if (total_internal) {
                vec3 refract_dir = refract(rd_i, microNormal, rs);
                if (refract_dir != vec3(0.0)) {
                    next_rd = refract_dir;
                    inverse_0 = !inverse_0; // 穿过介质，翻转状态
                } else {
                    next_rd = reflect(rd_i, microNormal); // 全反射
                    current_type = Reflection;
                }
            } else {
                next_rd = reflect(rd_i, microNormal);
                current_type = Reflection;
            }
            bsdf_weight = surface.Cd * (1.0 - rC.rgb * surface.S.x) / (max(P_refr, 0.125) + 1e-3);
        } else {
            // [漫反射 Lobe + 屏幕空间路径引导]
            current_type = Diffussion;
            float w = 1.0;

            if (depth == 0) {
                vec2 prev_coord = reproject(ro_o).xy;
                diffuseIllumiantionBufferDataW data0 = samplePrevDiffuse(prev_coord * resolution_global);
                float length_shY = length(data0.data_swap.shY.xyz);

                if (data0.data_swap.shY.w * getRnd() < data0.data_swap.shY.w - length_shY || length_shY < 1e-6 || prev_coord.x < 0.0 || prev_coord.x > 1.0 || prev_coord.y < 0.0 || prev_coord.y > 1.0) {
                    next_rd = DiffuseNormal(macroNormal, ro_o);
                } else {
                    vec4 Nv = WeightedDiffuseEx(normalize(data0.data_swap.shY.xyz), ro_o, clamp(length_shY / (1e-6 + data0.data_swap.shY.w), 1e-5, 0.975));
                    next_rd = Nv.xyz;
                    if (dot(next_rd, macroNormal) < 0.0) next_rd = DiffuseNormal(macroNormal, ro_o);
                    else w = max(0.0, dot(next_rd, macroNormal)) * Nv.w;
                }
            } else {
                next_rd = DiffuseNormal(macroNormal, ro_o);
            }

            bsdf_weight = surface.Cd * (1.0 - rC.rgb * surface.S.x) / (max(P_diff, 0.125) + 1e-3) * w;
        }

        // --- 5. NEE (直接光源采样 / 阳光) ---
        // 此时我们已得知 current_type，在此处干净地进行 NEE
        if (dot(macroNormal, lightDir) < 0.0 && !isDarkened) {
            vec3 sunL = sampleSunlight(ro_o, normal, surface.Cs, surface.Cd, rd_i, surface.S, surface.R, lightDir, lightDir.y > 0.0, current_type, macroNormal, inverse_0);
            if (depth == 0) L_direct_0 = sunL;
            else L_indirect += throughput * sunL;
        }

        // --- 6. 记录 G-Buffer (仅限 Depth 0) ---
        if (depth == 0) {
            first_p = ro_o;
            first_n = normal;
            first_macro_n = macroNormal;
            first_t = t;
            first_type = current_type;
            first_albedo = surface.Cs;
            first_albedo2 = surface.Cd;
            first_roughness = surface.R.x;
            first_rd_o = next_rd;
            first_n_i = n_i;
            first_n_o = current_type == Refraction ? n_o : n_i;
            first_micro_n = microNormal;
            first_emission_val = segment_emission;
            first_light_surf = surface.light;

            float p1 = P_spec + (1.0 - P_spec) * F * surface.S.y;
            mixWeight = vec2(p1, (1.0 - p1) * (1.0 - min(F, 1.0)) * surface.S.y);
            hitSmoothSurface = (surface.R.x < 0.00125);

            #if useReSTIR
            // =======================================================================
            // ReSTIR 时空重用（无遮挡快速筛洗 + 延迟可见性 + 严格测度匹配版）
            // =======================================================================
            if (current_type == Diffussion) {
                Reservoir r = Reservoir(GI_Sample(vec3(0), vec3(0), vec3(0), vec3(0), 0.0), 0.0, 0.0, 0.0);
                vec2 prev_coord = reproject(first_p).xy;

                // 1. 初始盲追采样 (余弦半球分布)
                vec3 next_rd = DiffuseNormal(first_macro_n, first_p);
                vec3 ro_1, rd_1;
                float t_1 = raycast(first_p + first_macro_n * 0.001, next_rd, ro_1, rd_1, !inverse_0);

                GI_Sample candidate;
                candidate.wi = next_rd;
                vec3 sample_rad = vec3(0.0);

                if (t_1 > -0.5) {
                    candidate.pos = ro_1;
                    candidate.normal = faceforward(tmp_Payload.material.normal, tmp_Payload.material.normal, next_rd);
                    candidate.is_sky = 0.0;
                    material surf_1 = Material_(ro_1, candidate.normal);
                    sample_rad += surf_1.light;
                    // if (dot(candidate.normal, lightDir) < 0.0 && !isDarkened) {
                    //     sample_rad += sampleSunlight(ro_1, candidate.normal, surf_1.Cs, surf_1.Cd, next_rd, surf_1.S, surf_1.R, lightDir, lightDir.y > 0.0, Diffussion, candidate.normal, inverse_0);
                    // }
                } else {
                    candidate.pos = first_p + next_rd * 10000.0;
                    candidate.normal = -next_rd;
                    candidate.is_sky = 1.0;
                    sample_rad += SampleSky(next_rd).xyz;
                }

                candidate.radiance = sample_rad;

                float p_hat_init = evaluatePHat(candidate, first_p, first_n, first_albedo2);

                // 计算余弦采样的面积测度 PDF
                float cos_init = clamp(dot(first_macro_n, next_rd), 0.0, 1.0);
                float cos_s_init = clamp(dot(candidate.normal, -next_rd), 0.0, 1.0);
                float dist2_init = max(dot(candidate.pos - first_p, candidate.pos - first_p), 0.001);
                float G_init = (cos_init * cos_s_init) / dist2_init;
                float p_area = (candidate.is_sky > 0.5) ? max(cos_init / PI, 1e-7) : max(G_init / PI, 1e-7);

                updateReservoir(r, candidate, p_hat_init, p_hat_init / p_area, getRnd());
                r.M = 1.0;

                // 2. 时域重用
                if (all(greaterThanEqual(prev_coord, vec2(0.0))) && all(lessThanEqual(prev_coord, vec2(1.0)))) {
                    Reservoir r_prev = samplePrevReservoirStochastic(prev_coord, resolution_global, getRnd());
                    if (r_prev.M > 0.0) {
                        float p_hat_temporal = evaluatePHat(r_prev.samplePoint, first_p, first_n, first_albedo2);
                        if (p_hat_temporal > 0.0) {
                            float temp_weight = p_hat_temporal * r_prev.W * r_prev.M;
                            updateReservoir(r, r_prev.samplePoint, p_hat_temporal, temp_weight, getRnd());
                            r.M += r_prev.M;
                        }
                    }
                }

                float p_hat_temp_final = evaluatePHat(r.samplePoint, first_p, first_n, first_albedo2);
                r.W = r.w_sum / max(r.M * p_hat_temp_final, 1e-5);

                // 3. 空域重用
                Reservoir spatialR = Reservoir(GI_Sample(vec3(0), vec3(0), vec3(0), vec3(0), 0.0), 0.0, 0.0, 0.0);
                float p_hat_self = evaluatePHat(r.samplePoint, first_p, first_n, first_albedo2);
                updateReservoir(spatialR, r.samplePoint, p_hat_self, p_hat_self * r.W * r.M, getRnd());

                float spatial_M_sum = r.M;
                for (int i = 0; i < RESTIR_SPATIAL_SAMPLES; i++) {
                    vec2 offset = (vec2(getRnd(), getRnd()) * 2.0 - 1.0) * float(RESTIR_SPATIAL_RADIUS);
                    vec2 neighbor_uv = (vec2(prev_coord * resolution_global) + offset) / resolution_global;

                    if (all(greaterThanEqual(neighbor_uv, vec2(0.0))) && all(lessThanEqual(neighbor_uv, vec2(1.0)))) {
                        Reservoir r_n = samplePrevReservoirStochastic(neighbor_uv, resolution_global, getRnd());

                        if (r_n.M > 0.0) {
                            float p_hat_n = evaluatePHat(r_n.samplePoint, first_p, first_n, first_albedo2);
                            if (p_hat_n > 0.0) {
                                float weight_n = p_hat_n * r_n.W * r_n.M;
                                updateReservoir(spatialR, r_n.samplePoint, p_hat_n, weight_n, getRnd());
                            }
                            spatial_M_sum += r_n.M;
                        }
                    }
                }

                const float M_cap = RESTIR_M_CAP; // 最大样本数量上限，防止极端情况过度放大权重

                float old_M = spatial_M_sum;
                float scale = M_cap / max(old_M, 1e-10); // 防除零
                float cond = step(M_cap, old_M); // old_M ≥ M_cap 时 cond = 1
                spatialR.w_sum = mix(spatialR.w_sum, spatialR.w_sum * scale, cond);
                spatial_M_sum = min(old_M, M_cap);

                spatialR.M = spatial_M_sum;
                float p_hat_final = evaluatePHat(spatialR.samplePoint, first_p, first_n, first_albedo2);
                spatialR.W = spatialR.w_sum / max(spatialR.M * p_hat_final, 1e-5);

                curReservoirs.data[idx] = packReservoir(spatialR);

                // 4. 延迟可见性
                bool is_visible = true;
                if (p_hat_final > 0.0 && spatialR.samplePoint.is_sky < 0.5) {
                    is_visible = traceShadowSafe(first_p, first_macro_n, spatialR.samplePoint.pos, spatialR.samplePoint.normal);
                }

                // 5. 直接重建
                if (p_hat_final > 0.0 && is_visible) {
                    float G_final;
                    vec3 L_dir_final;
                    if (spatialR.samplePoint.is_sky > 0.5) {
                        L_dir_final = spatialR.samplePoint.wi;
                        G_final = clamp(dot(first_n, L_dir_final), 0.0, 1.0);
                    } else {
                        vec3 L_to_sample = spatialR.samplePoint.pos - first_p;
                        float dist2 = max(dot(L_to_sample, L_to_sample), 0.00001);
                        L_dir_final = L_to_sample / sqrt(dist2);
                        float cos_v = clamp(dot(first_n, L_dir_final), 0.0, 1.0);
                        float cos_s = clamp(dot(spatialR.samplePoint.normal, -L_dir_final), 0.0, 1.0);
                        G_final = (cos_v * cos_s) / dist2;
                    }

                    L_indirect = spatialR.samplePoint.radiance * G_final * spatialR.W * (first_albedo2 / PI);
                    first_rd_o = spatialR.samplePoint.wi;
                } else {
                    L_indirect = vec3(0.0);
                }

                // 多跳光线路径引导
                float w = 1.0;
                diffuseIllumiantionBufferDataW data0 = samplePrevDiffuse(prev_coord * resolution_global);
                float length_shY = length(data0.data_swap.shY.xyz);

                if (data0.data_swap.shY.w * getRnd() < data0.data_swap.shY.w - length_shY || length_shY < 1e-6 || prev_coord.x < 0.0 || prev_coord.x > 1.0 || prev_coord.y < 0.0 || prev_coord.y > 1.0) {
                    next_rd = DiffuseNormal(first_macro_n, first_p);
                } else {
                    vec4 Nv = WeightedDiffuseEx(normalize(data0.data_swap.shY.xyz), first_p, clamp(length_shY / (1e-6 + data0.data_swap.shY.w), 1e-5, 0.975));
                    next_rd = Nv.xyz;
                    if (dot(next_rd, first_macro_n) < 0.0) next_rd = DiffuseNormal(first_macro_n, first_p);
                    else w = max(0.0, dot(next_rd, first_macro_n)) * Nv.w;
                }

                bsdf_weight = surface.Cd * (1.0 - rC.rgb * surface.S.x) / (max(P_diff, 0.125) + 1e-3) * w;
            }
            #endif
        }

        // 更新吞吐量
        throughput *= bsdf_weight;

        // --- 7. Russian Roulette (轮盘赌终止) ---
        if (depth >= 2) {
            float p_survive = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
            if (getRnd() > p_survive) break;
            throughput /= p_survive;
        }

        ro_i = ro_o + macroNormal * (current_type == Refraction ? -0.001 : 0.001);
        rd_i = next_rd;
    }

    // -----------------------------------------------------------------------------------
    // 最终 G-Buffer 与降噪 Buffer 写入逻辑
    // -----------------------------------------------------------------------------------

    // 汇总光照 (限制最大强度)
    vec3 total_illumination = L_indirect + L_direct_0;
    if (any(isnan(total_illumination))) total_illumination = vec3(0);
    total_illumination = clamp(total_illumination, 0.0, 10000.0);

    // 写入常规 G-Buffer
    denoiseBuffer.data[idx].reflectWeight = mixWeight.x;
    denoiseBuffer.data[idx].refractWeight = mixWeight.y;
    denoiseBuffer.data[idx].albedo = first_albedo;
    denoiseBuffer.data[idx].albedo2 = first_albedo2;
    denoiseBuffer.data[idx].distance = first_t;
    denoiseBuffer.data[idx].light = first_light_surf;
    denoiseBuffer.data[idx].macroNormal = first_macro_n;
    denoiseBuffer.data[idx].illumiantionType = first_type;
    denoiseBuffer.data[idx].roughness = first_roughness;
    denoiseBuffer.data[idx].absorption = current_absorption;
    denoiseBuffer.data[idx].rd = first_rd_i;

    diffuseIllumiantionBuffer.data[idx].data_swap = init_SH();
    reflectIllumiantionBuffer.data[idx].data_swap = vec3(0);
    refractIllumiantionBuffer.data[idx].data_swap = vec3(0);
    diffuseIllumiantionBuffer.data[idx].normal = first_macro_n;
    diffuseIllumiantionBuffer.data[idx].normal2 = faceforward(first_n, first_n, -first_macro_n);
    diffuseIllumiantionBuffer.data[idx].pos = first_p;

    // 写入反射重投影特征
    vec3 r_rd, r_ro;
    vec3 r_n = normalize(mix(first_n, first_macro_n, 1.0 - exp(-0.05 * first_t)));
    vec3 r_rd_i = GetSpecularDominantDirection(r_n, first_rd_i, first_roughness);
    float t_refl = raycast(first_p + first_macro_n * 0.0001, r_rd_i, r_ro, r_rd, false);

    if (first_roughness <= 0.000125) {
        if (t_refl > -0.5) {
            vec3 reconstructed_pos = first_p + reflect(r_ro - first_p, r_n);
            vec3 reconstructed_normal = reflect(tmp_Payload.material.normal, r_n);
            reflectIllumiantionBuffer.data[idx].normal = t_refl * reconstructed_normal;
            reflectIllumiantionBuffer.data[idx].pos = reconstructed_pos;
        } else {
            reflectIllumiantionBuffer.data[idx].normal = 5.0 * r_rd_i;
            reflectIllumiantionBuffer.data[idx].pos = first_p;
        }
    } else {
        if (t_refl > -0.5) {
            reflectIllumiantionBuffer.data[idx].normal = t_refl * r_rd_i;
            reflectIllumiantionBuffer.data[idx].pos = first_p;
        } else {
            reflectIllumiantionBuffer.data[idx].normal = 5.0 * r_rd_i;
            reflectIllumiantionBuffer.data[idx].pos = first_p;
        }
    }
    refractIllumiantionBuffer.data[idx].normal = first_n;
    refractIllumiantionBuffer.data[idx].pos = first_p;

    // 写入折射重投影特征
    if (first_roughness <= 0.00125 && mixWeight.y > 0.001) {
        float rs = first_n_i == Refractive_Index ? Refractive_Index : 1.0 / Refractive_Index;
        vec3 refract_rd = refract(first_rd_i, first_n, rs);
        bool is_refract = refract_rd != vec3(0);
        if (!is_refract) refract_rd = reflect(first_rd_i, first_n);
        float t_refr = raycast(first_p + (is_refract ? -1.0 : 1.0) * first_macro_n * 0.0001, refract_rd, r_ro, r_rd, false);
        if (t_refr > -0.5) {
            vec3 reconstructed_pos = is_refract ? first_p : first_p + reflect(r_ro - first_p, first_n);
            vec3 reconstructed_normal = is_refract ? refract(tmp_Payload.material.normal, first_n, rs) : reflect(tmp_Payload.material.normal, first_n);
            refractIllumiantionBuffer.data[idx].normal = reconstructed_normal;
            refractIllumiantionBuffer.data[idx].pos = reconstructed_pos;
            diffuseIllumiantionBuffer.data[idx].normal2 = -reconstructed_normal;
        }
    }

    // 分配光照到对应的降噪 Buffer
    switch (first_type) {
        case 0:
        reflectIllumiantionBuffer.data[idx].data_swap = total_illumination;
        break;
        case Diffussion:
        L_indirect = clamp(L_indirect, 0.0, 250.0 / avgExposure);

        // 间接光
        SH indSH = irradiance_to_SH(L_indirect / (first_albedo2 + 1e-3), first_rd_o);

        // 直接光
        SH dirSH = irradiance_to_SH(L_direct_0 / (first_albedo2 + 1e-3), -lightDir);

        indSH.CoCg += dirSH.CoCg;
        indSH.shY += dirSH.shY;
        diffuseIllumiantionBuffer.data[idx].data_swap = indSH;
        break;
        case Reflection:
        total_illumination = clamp(total_illumination, 0.0, 1000.0 / avgExposure);
        reflectIllumiantionBuffer.data[idx].data_swap = total_illumination;
        break;
        case Refraction:
        refractIllumiantionBuffer.data[idx].data_swap = total_illumination;
        break;
    }

    // 体积光 (God Rays)
    vec3 sumGodRay = vec3(0);
    for (int i = 0; i < Volumetric_Light_Samples; i++) {
        sumGodRay += sampleGodRay(SunLight, MoonLight, ro, rd, first_t, lightDir, true, original_inverse_0).xyz;
    }
    denoiseBuffer.data[idx].emission = first_emission_val + sumGodRay * (1.0 / Volumetric_Light_Samples);

    return vec4(total_illumination, first_t);
}
