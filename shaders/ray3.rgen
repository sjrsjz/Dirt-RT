#version 460 core
#extension GL_EXT_ray_tracing : enable
// Allocation/LRU phase. A distinct Vulkanite execution group provides the
// barrier between atomic geometry requests and this single-writer allocator.
#include "/lib/buffers/radiance_cache.glsl"

void main() {
    if (any(notEqual(gl_LaunchIDEXT, uvec3(0u)))) return;
    processRadianceCacheAllocationRequests(camPos, uint(max(frame_id, 0)));
}
