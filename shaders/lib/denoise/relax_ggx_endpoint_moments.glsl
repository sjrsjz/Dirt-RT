void relaxLookupGGXAngularMoments(float ggxAlpha, float NoV,
    vec3 normal, vec3 viewDirection, out vec3 angularMean,
    out mat3 angularSecondMoment) {
    vec2 grid = sqrt(clamp(vec2(ggxAlpha, NoV), vec2(0.0), vec2(1.0))) * 7.0;
    ivec2 i0 = ivec2(floor(grid));
    ivec2 i1 = min(i0 + 1, ivec2(7));
    vec2 f = fract(grid);
    int k00 = i0.y * 8 + i0.x;
    int k10 = i0.y * 8 + i1.x;
    int k01 = i1.y * 8 + i0.x;
    int k11 = i1.y * 8 + i1.x;
    vec4 ab0 = mix(mix(RELAX_GGX_AB0[k00], RELAX_GGX_AB0[k10], f.x),
        mix(RELAX_GGX_AB0[k01], RELAX_GGX_AB0[k11], f.x), f.y);
    vec2 b1 = mix(mix(RELAX_GGX_B1[k00], RELAX_GGX_B1[k10], f.x),
        mix(RELAX_GGX_B1[k01], RELAX_GGX_B1[k11], f.x), f.y);

    vec3 n = relaxSafeNormalize(normal, vec3(0.0, 1.0, 0.0));
    vec3 tangentView = viewDirection - n * dot(n, viewDirection);
    vec3 t;
    if (dot(tangentView, tangentView) > 1e-10) {
        t = normalize(tangentView);
    } else {
        vec3 helper = abs(n.y) < 0.999
            ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        t = normalize(cross(helper, n));
    }
    vec3 b = normalize(cross(n, t));
    mat3 localToWorld = mat3(t, b, n);
    mat3 localB = mat3(
        vec3(ab0.z, 0.0, b1.y),
        vec3(0.0, ab0.w, 0.0),
        vec3(b1.y, 0.0, b1.x));
    angularMean = localToWorld * vec3(ab0.x, 0.0, ab0.y);
    angularSecondMoment =
        localToWorld * localB * transpose(localToWorld);
}

