// --- Core distance functions (unchanged from original) ---

float dot2(vec2 v) {
    return dot(v, v);
}

float sdSegment(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

float sdBezier(vec2 pos, vec2 A, vec2 B, vec2 C) {
    vec2 a = B - A;
    vec2 b = A - 2.0 * B + C;
    vec2 c = a * 2.0;
    vec2 d = A - pos;
    float kk = 1.0 / dot(b, b);
    float kx = kk * dot(a, b);
    float ky = kk * (2.0 * dot(a, a) + dot(d, b)) / 3.0;
    float kz = kk * dot(d, a);
    float p = ky - kx * kx;
    float p3 = p * p * p;
    float q = kx * (2.0 * kx * kx - 3.0 * ky) + kz;
    float h = q * q + 4.0 * p3;
    if (h >= 0.0) {
        h = sqrt(h);
        vec2 x = (vec2(h, -h) - q) / 2.0;
        vec2 uv = sign(x) * pow(abs(x), vec2(1.0 / 3.0));
        float t = clamp(uv.x + uv.y - kx, 0.0, 1.0);
        return sqrt(dot2(d + (c + b * t) * t));
    } else {
        float z = sqrt(-p);
        float v = acos(q / (p * z * 2.0)) / 3.0;
        float m = cos(v);
        float n = sin(v) * 1.732050808;
        vec3 t = clamp(vec3(m + m, -n - m, n - m) * z - kx, 0.0, 1.0);
        return sqrt(min(dot2(d + (c + b * t.x) * t.x),
                dot2(d + (c + b * t.y) * t.y)));
    }
}

// --- Unified glyph dispatch ---
// Loops over primitives for glyph `idx`; returns signed distance to outline.
float sdf_sga(int idx, vec2 p) {
    if (idx < 0 || idx >= 26) return 1e9;

    uint base = SGA_OFFSET[idx] * 7u;
    uint count = SGA_COUNT[idx];

    float d = 1e9;
    for (uint i = 0u; i < count; i++) {
        uint off = base + i * 7u;
        float t = SGA_PRIMS[off];
        vec2 p0 = vec2(SGA_PRIMS[off + 1u], SGA_PRIMS[off + 2u]);
        vec2 p1 = vec2(SGA_PRIMS[off + 3u], SGA_PRIMS[off + 4u]);

        if (t < 0.5) {
            // Segment
            d = min(d, sdSegment(p, p0, p1));
        } else if (t < 1.5) {
            // Bezier
            vec2 p2 = vec2(SGA_PRIMS[off + 5u], SGA_PRIMS[off + 6u]);
            d = min(d, sdBezier(p, p0, p1, p2));
        } else {
            // Point
            d = min(d, length(p - p0));
        }
    }
    return d;
}
