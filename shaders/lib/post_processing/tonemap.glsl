#ifndef TONEMAP_GLSL
#define TONEMAP_GLSL

vec3 ACESFilm(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// ===========================================================================
// TonyMcMapface Tiny MLP Tonemapper Constants (99 Params, C1 Continuous)
// https://www.shadertoy.com/view/s32XRK
// ===========================================================================
const mat4 W_H0 = mat4(0.39586228f, -0.03972201f, 0.80481762f, 0.04644348f, 1.58664536f, 1.66902244f, 2.44403410f, 0.55288339f, 0.36988291f, 0.15207146f, 1.64132059f, -1.13008571f, -5.94598198f, -2.82862377f, -5.82778120f, -1.80443943f);
const mat4 W_H1 = mat4(0.18353821f, 0.32969889f, -1.00356138f, 0.36945057f, 0.95604730f, 1.08331323f, 0.56690210f, 1.08915603f, 0.02231202f, -0.36653680f, -0.09584079f, 0.05614884f, -3.45653129f, -3.48821163f, -1.57088459f, -3.57599139f);
const mat4 W_H2 = mat4(-1.63317251f, 0.13153945f, -0.94357085f, -1.13281119f, -0.26234260f, 0.82354331f, -3.42180729f, -1.63760138f, -1.29429603f, -0.32949299f, 0.10173334f, -0.43876860f, 2.70939469f, 2.06048155f, 3.54249549f, 4.33876848f);
const vec4 B_H0 = vec4(0.66067636f, 0.29956132f, 1.76998234f, 0.17330712f);
const vec4 B_H1 = vec4(0.63329625f, 1.36817801f, -0.14686975f, 0.42374569f);
const vec4 B_H2 = vec4(-0.50533009f, 0.80425847f, -1.44877112f, -2.47578382f);
const mat4x3 W_O0 = mat4x3(-0.70704323f, 0.01483737f, 0.37019095f, -0.05342029f, 0.05530520f, -2.54849434f, 0.41999695f, 0.02310869f, 0.01786434f, -3.08490849f, -0.21992514f, 0.03777298f);
const mat4x3 W_O1 = mat4x3(2.50645280f, 3.12841654f, 0.46637687f, -2.77187896f, 0.31183574f, 0.15295352f, -0.44559595f, -0.54871750f, -4.36423111f, 2.30986452f, -3.21602535f, 0.97358066f);
const mat4x3 W_O2 = mat4x3(-0.22230430f, -0.03942725f, -0.42500046f, 0.95312279f, 0.07827633f, 0.26239559f, -0.94722545f, -0.05049668f, -0.10606785f, 2.15497899f, -0.03251265f, 6.17893267f);
const vec3 B_O = vec3(-2.90981388f, 0.13765818f, 0.26697257f);

vec3 TonyMcMapface_Tiny(vec3 hdrColor) {
    hdrColor = hdrColor.zyx;
    float luma = dot(hdrColor, vec3(0.2126, 0.7152, 0.0722));
    float luma_rein = luma / (1.0 + luma);
    
    vec4 X = vec4(hdrColor / max(luma, 1e-6f), luma_rein);
    
    vec4 h0 = W_H0 * X + B_H0; h0 = h0 / (1.0 + exp(-h0)); // SiLU
    vec4 h1 = W_H1 * X + B_H1; h1 = h1 / (1.0 + exp(-h1)); // SiLU
    vec4 h2 = W_H2 * X + B_H2; h2 = h2 / (1.0 + exp(-h2)); // SiLU
    
    vec3 scale = W_O0 * h0 + W_O1 * h1 + W_O2 * h2 + B_O;
    scale = log(1.0 + exp(scale));
    
    return clamp(luma_rein * scale, 0.0, 1.0);
}
#endif // TONEMAP_GLSL