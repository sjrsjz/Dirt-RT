#ifndef TONEMAP_GLSL
#define TONEMAP_GLSL

vec3 ACESFilm(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}
// --- 神经网络色调映射器 (20神经元隐藏层 / 最终版) ---
// 模型结构: 输入(4) -> Sigmoid -> 输出(3) -> Sigmoid -> x/(x+1)*2
// 使用了独特的亮度和最终激活函数。

// --- 1. 模型参数 (从新训练的模型中提取) ---

// === 隐藏层权重 W_h (20x4 矩阵) ===
// 我们将其分解为 5 个 mat4x4
const mat4 W_H1 = mat4(
    vec4(  2.5854292,  22.692913,   6.219134,    7.878834),
    vec4(-13.553128,    0.8249421, -0.4765078,   0.5182019),
    vec4(  3.133925,   -1.1988831, -1.4772791,  12.11475),
    vec4(  4.186449,   -4.769022,  -6.3306017,  -9.2925806)
);
const mat4 W_H2 = mat4(
    vec4(-0.25695404, -13.836102,  -0.6705737,  -0.9569413),
    vec4( 1.1992688,   -1.3150349, -0.41978428,  2.9551783),
    vec4(-20.259472,    1.2386097,  18.423204,  -2.3564773),
    vec4( -7.430541,    7.984279,  -4.297575,   -6.903916)
);
const mat4 W_H3 = mat4(
    vec4( 0.9354518,   -3.587927,   -0.19424511,  0.21159042),
    vec4( 2.4342198,    8.595676,    2.0971808,   2.0586674),
    vec4(-18.296129,    0.35831863,  0.2727218,   0.54054385),
    vec4(-13.655127,   -12.913663,    9.8761206, -35.21231)
);
const mat4 W_H4 = mat4(
    vec4(  0.074371397,-2.3884158,  -8.665415,   1.971607),
    vec4( -0.31414124,  7.542763,    1.1072178, -1.0894928),
    vec4( -0.019014632, 3.4701917,   2.1957161, -2.2422965),
    vec4(  6.089025,   -6.8346543, -10.447622,  -1.9619119)
);
const mat4 W_H5 = mat4( // 第5个矩阵，只用前4行
    vec4(  8.5217276,  -1.5852227,   0.30209112,  4.235959),
    vec4(  1.9262714,   0.9597499,   9.867214,    1.6413811),
    vec4( -2.9597895,   4.9942255,   10.63089,    1.1591718),
    vec4( -1.6072912,  -7.5042086,  -17.175219,  -16.072731)
);
// === 隐藏层偏置 B_h (20维向量) ===
// 分解为 5 个 vec4
const vec4 B_H0 = vec4(  4.1440167, -19.270737,    1.3271451, -13.129771);
const vec4 B_H1 = vec4( -1.457871,    5.9538455,  -15.342329,    0.5417728);
const vec4 B_H2 = vec4( 28.884047,   -1.3750111,  -10.093612,   33.248314);
const vec4 B_H3 = vec4( -2.8576562,  -5.4355035,   15.997436,   -2.673221);
const vec4 B_H4 = vec4( -6.029298,    1.6089772,   -4.439267,   -2.091334);

// === 输出层权重 W_o (3x20 矩阵) ===
// 定义为 3 个 20维的行向量 (每个由 5 个 vec4 构成)
const vec4 W_O_ROW_R[5] = vec4[5](
    vec4(0.36319074, -0.5511948, 0.78489596, 3.26947),
    vec4(-31.061308, -0.06776211, 22.65666, -3.8446145),
    vec4(2.5514867, 3.7832458, 1.383853, -8.671801),
    vec4(3.484162, -7.801134, -0.9401911, -9.204619),
    vec4(-0.45817536, 3.1718292, 2.8751545, 2.4152215)
);
const vec4 W_O_ROW_G[5] = vec4[5](
    vec4(0.5807465, -2.2715182, -1.0329854, 0.6652068),
    vec4(0.3173033, 2.032412, -0.916837, 0.5404973),
    vec4(-1.9922731, -2.791731, 1.210105, -6.4078255),
    vec4(2.2904677, 3.141277, -1.3250101, -2.5316148),
    vec4(1.8131572, -0.517145, -1.262814, -24.577143)
);
const vec4 W_O_ROW_B[5] = vec4[5](
    vec4(1.7080044, 25.263302, 1.8357164, -4.823461),
    vec4(0.08993842, -1.5836183, 1.1320994, 0.4111112),
    vec4(-3.6538038, -17.440105, 1.3336277, -9.556131),
    vec4(3.0294719, 2.2406611, 3.9992063, 2.325115),
    vec4(0.68287027, 0.07114576, -0.5914838, -2.206986)
);
// === 输出层偏置 B_o ===
const vec3 B_O = vec3(2.536988, 6.411228, 6.004845);

// --- 2. 辅助函数 ---
vec4 sigmoid(vec4 v) { return 1.0 / (1.0 + exp(-v)); }
vec3 sigmoid(vec3 v) { return 1.0 / (1.0 + exp(-v)); }

// 计算两个 20维向量 (vec4[5]) 的点积
float dot20(vec4 row[5], vec4 col[5]) {
    float sum = dot(row[0], col[0]);
    sum += dot(row[1], col[1]);
    sum += dot(row[2], col[2]);
    sum += dot(row[3], col[3]);
    sum += dot(row[4], col[4]);
    return sum;
}

float luma_mapping(vec3 color_in) {
    vec3 linear_rgb = color_in / max(1.0 - color_in, 0.0001);
    float luma = dot(linear_rgb, vec3(0.2126, 0.7152, 0.0722));
    return luma / (1.0 + luma);
}

vec3 final_activation(vec3 x) {
    x = sigmoid(x);
    return x / (x + 1.0) * 2.0;
}

// --- 3. 神经网络前向传播函数 ---
vec3 tonemap_NeuralNetwork(vec3 color_input_normalized) {
    // 1. 准备输入向量
    float luma = luma_mapping(color_input_normalized);
    vec4 net_input = vec4(color_input_normalized, luma);
    
    // 2. 隐藏层计算
    vec4 h[5]; // 现在需要一个长度为 5 的数组来存储 20 个值
    h[0] = sigmoid((W_H1 * net_input) + B_H0);
    h[1] = sigmoid((W_H2 * net_input) + B_H1);
    h[2] = sigmoid((W_H3 * net_input) + B_H2);
    h[3] = sigmoid((W_H4 * net_input) + B_H3);
    h[4] = sigmoid((W_H5 * net_input) + B_H4); // 计算第 5 块
    
    // 3. 输出层计算
    vec3 output_linear;
    output_linear.r = dot20(W_O_ROW_R, h);
    output_linear.g = dot20(W_O_ROW_G, h);
    output_linear.b = dot20(W_O_ROW_B, h);
    
    // 4. 应用最终的偏置
    output_linear += B_O;
    
    // 5. 应用最终的激活函数
    return final_activation(output_linear);
}
#endif // TONEMAP_GLSL